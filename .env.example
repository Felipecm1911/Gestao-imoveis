# Copie para .env e troque TODOS os valores. Nunca commite o .env.
POSTGRES_DB=gestao_imoveis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-me-superuser
APP_OWNER_PASSWORD=troque-me-owner
APP_USER_PASSWORD=troque-me-user
DB_PORT=5432

# Porta local do Imobly no Docker
WEB_PORT=5181

# Backend
APP_COOKIE_SECURE=false
APP_UPLOAD_DIR=/data/uploads
SPRING_PROFILES_ACTIVE=demo
